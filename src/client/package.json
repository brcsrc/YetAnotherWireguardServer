{
  "name": "@yaws/yaws-ts-api-client",
  "version": "1.0.0",
  "main": "../../build/client/index.js",
  "types": "../../build/client/types/index.d.ts",
  "exports": {
    ".": {
      "import": "../../build/client/index.js",
      "types": "../../build/client/types/index.d.ts"
    }
  },
  "scripts": {
    "generate": "cp ../../build/openapi.json ./openapi.json && openapi-generator-cli generate -i ./openapi.json -g typescript-fetch -o ./src",
    "build": "tsc"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@openapitools/openapi-generator-cli": "^2.18.4"
  }
}
